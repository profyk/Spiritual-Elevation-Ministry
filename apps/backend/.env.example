# Copy to .env.local for development (tsx/dotenv picks it up automatically
# via `npm run dev`). In production (Railway), set these as real environment
# variables instead — never commit actual values.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL, from Supabase project settings → API.
SUPABASE_URL=
# Anon key — used for every request that should be RLS-scoped to the
# caller's own identity (nearly everything). Safe in principle, but this
# is server-only in this app; never send it to a browser directly.
SUPABASE_ANON_KEY=
# Service role key — bypasses RLS entirely. Used sparingly: creating an
# admin's Supabase Auth user, minting signed Storage URLs, and the two
# /cron/* jobs. Never expose this to the frontend/admin apps or log it.
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of the exact origins allowed to call this API —
# your deployed frontend and admin URLs (no trailing slash), plus
# http://localhost:3000,http://localhost:3001 for local dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
# Verified sending address/domain in Resend, e.g. "Spiritual Elevation Ministry <no-reply@example.org>"
# Admin notifications (new request, new conversation, new testimony) go to
# every active admin_users row's own auth email, not a single shared inbox —
# each admin can opt out per category at Admin -> Notification Preferences.
EMAIL_FROM=

# The deployed ADMIN app's URL (not the public frontend's) — used to build
# the "View in admin" link in notification emails.
ADMIN_URL=http://localhost:3001

# ── Cron (.github/workflows/cron.yml) ────────────────────────────────────
# Shared secret the scheduled jobs send as `Authorization: Bearer <value>`
# to /cron/*. Generate a long random string (e.g. `openssl rand -hex 32`);
# without it those routes refuse every request, including real ones.
CRON_SECRET=

# ── App ─────────────────────────────────────────────────────────────────
# Port this service listens on. Railway sets PORT itself in production —
# leave unset there and let it override this.
PORT=3002
