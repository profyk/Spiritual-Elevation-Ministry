# Copy to .env.local for development. In production (Vercel), set these as
# real environment variables instead — never commit actual values.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL and anon key, from Supabase project settings → API. Used
# directly in the browser ONLY for visitor anonymous auth and Realtime
# chat subscriptions — every other read/write goes through the backend API
# below. The anon key is safe for the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Backend API ─────────────────────────────────────────────────────────
# The deployed backend's URL (apps/backend, on Railway in production).
NEXT_PUBLIC_API_URL=http://localhost:3002

# ── App ─────────────────────────────────────────────────────────────────
# This app's own public URL, used for absolute links in metadata/sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── WhatsApp ────────────────────────────────────────────────────────────
# Dev/local fallback only. Production should always configure the real
# number via Admin -> Settings -> Communication -> WhatsApp instead.
WHATSAPP_FALLBACK_NUMBER=

# ── Testing (optional) ──────────────────────────────────────────────────
# Enables tests/e2e/acceptance.spec.ts and admin-mfa.spec.ts, which
# provision and delete their own throwaway admin_users accounts via the
# Supabase auth admin API. Deliberately a SEPARATE variable from the
# backend's SUPABASE_SERVICE_ROLE_KEY — point it at a staging/preview
# Supabase project's service role key, never production's. Leave unset to
# skip both test files (they self-skip rather than fail without it).
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Where the separate admin app runs, for the same two test files.
PLAYWRIGHT_ADMIN_BASE_URL=http://localhost:3001
