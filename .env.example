# Copy this file to .env.local for development. Never commit the real values.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL and anon key, from Supabase project settings → API.
# The anon key is safe for the browser — RLS is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Used sparingly (e.g. signed
# URL minting, scheduled jobs). Never expose to the client or log it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
# Verified sending address/domain in Resend, e.g. "Spiritual Elevation Ministry <no-reply@example.org>"
EMAIL_FROM=
# Where admin notifications (new request, new conversation) are sent.
ADMIN_NOTIFICATION_EMAIL=

# ── App ─────────────────────────────────────────────────────────────────
# Public site URL, used for absolute links in emails and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── WhatsApp ────────────────────────────────────────────────────────────
# Fallback WhatsApp number used only if none is set in Admin -> Settings ->
# Communication -> WhatsApp (website_settings key "whatsapp_number").
# Leave blank in production; configure it via the admin UI instead.
WHATSAPP_FALLBACK_NUMBER=
