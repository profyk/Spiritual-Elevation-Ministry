# Copy this file to .env.local for development. Never commit the real values.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL and anon key, from Supabase project settings → API.
# The anon key is safe for the browser — RLS is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Used sparingly (e.g. signed
# URL minting, scheduled jobs). Never expose to the client or log it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
# Verified sending address/domain in Resend, e.g. "Spiritual Elevation Ministry <no-reply@example.org>"
# Admin notifications (new request, new conversation, new testimony) go to
# every active admin_users row's own auth email, not a single shared inbox —
# each admin can opt out per category at Admin -> Notification Preferences.
EMAIL_FROM=

# ── App ─────────────────────────────────────────────────────────────────
# Public site URL, used for absolute links in emails and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the scheduled jobs (.github/workflows/cron.yml) send as
# `Authorization: Bearer <value>` to /api/cron/*. Generate a long random
# string (e.g. `openssl rand -hex 32`); without it those routes refuse
# every request, including real ones.
CRON_SECRET=

# ── WhatsApp ────────────────────────────────────────────────────────────
# Fallback WhatsApp number used only if none is set in Admin -> Settings ->
# Communication -> WhatsApp (website_settings key "whatsapp_number").
# Leave blank in production; configure it via the admin UI instead.
WHATSAPP_FALLBACK_NUMBER=

# ── Testing (optional) ──────────────────────────────────────────────────
# Enables tests/e2e/acceptance.spec.ts and admin-mfa.spec.ts, which
# provision and delete their own throwaway admin_users accounts. Deliberately
# a SEPARATE variable from SUPABASE_SERVICE_ROLE_KEY above, not just the same
# value under a different name — point it at a staging/preview Supabase
# project's service role key, never production's. Leave unset to skip both
# test files (they self-skip rather than fail without it).
E2E_SUPABASE_SERVICE_ROLE_KEY=
